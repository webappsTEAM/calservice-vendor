[Unit]
Description=CalTrack Workforce Automatic Job Dispatch Worker
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/workforce/backend
Environment="DJANGO_SETTINGS_MODULE=workforce_core.settings"
EnvironmentFile=/var/www/workforce/backend/.env

# Executable command: runs continuous stream consumer
ExecStart=/var/www/workforce/backend/venv/bin/python manage.py dispatch_worker --batch-size 10 --block-ms 500

# Process Supervision & Automatic Recovery
Restart=always
RestartSec=5s
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=15s

# Logging via systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=workforce-dispatch-worker

# Security Sandboxing
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
