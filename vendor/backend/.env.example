DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require
DJANGO_SECRET_KEY=your-secret-key-matching-primary-backend
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
FRONTEND_URL=http://localhost:5176

# RazorpayX Payouts (SEVO wallet withdrawals) -- a separate current account
# and API keys from plain Razorpay Payments used for customer checkout.
# Leave blank on an environment that doesn't have RazorpayX activated yet;
# every payout path degrades gracefully to AWAITING_RAZORPAYX_ACTIVATION
# until these are set, and retry_pending_razorpayx_activations picks up
# anything that queued once you add real values here.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# From the RazorpayX Dashboard: Account Settings > Webhooks, when you
# register https://<your-domain>/api/workforce/wallet/payout-webhook/
RAZORPAYX_WEBHOOK_SECRET=
